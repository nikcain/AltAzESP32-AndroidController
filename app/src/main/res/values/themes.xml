<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AltAzGoto" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Astronomy Night Vision Theme -->
        <item name="colorPrimary">@color/night_red</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/night_red</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorTertiary">@color/night_red</item>
        <item name="colorOnTertiary">@color/black</item>
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/night_red</item>
        <item name="colorOnSurfaceVariant">@color/night_red</item>
        <item name="android:textColor">@color/night_red</item>
        <item name="android:textColorPrimary">@color/night_red</item>
        <item name="android:textColorSecondary">@color/night_red</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="colorOutline">@color/night_red</item>
        <item name="colorError">@color/night_red</item>

        <!-- UI Control colors -->
        <item name="colorControlNormal">@color/night_red</item>
        <item name="colorControlActivated">@color/night_red</item>
        <item name="colorControlHighlight">#44FF0000</item> <!-- Faint red for ripples -->

        <!-- Force buttons to be outlined with red edges and black fill -->
        <item name="materialButtonStyle">@style/Widget.Material3.Button.OutlinedButton</item>

        <!-- Style for ImageButtons to ensure they are tinted red -->
        <item name="imageButtonStyle">@style/Widget.AltAzGoto.ImageButton</item>

        <!-- Popup Menu styling -->
        <item name="actionBarPopupTheme">@style/ThemeOverlay.AltAzGoto.Popup</item>
    </style>

    <style name="ThemeOverlay.AltAzGoto.Popup" parent="ThemeOverlay.Material3.AutoCompleteTextView">
        <item name="android:background">@color/black</item>
        <item name="colorSurface">@color/black</item>
        <item name="colorOnSurface">@color/night_red</item>
        <item name="android:textColor">@color/night_red</item>
    </style>

    <style name="Widget.AltAzGoto.ImageButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:tint">@color/night_red</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="Theme.AltAzGoto" parent="Base.Theme.AltAzGoto" />
</resources>